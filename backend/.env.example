# ==============================================================================
# AQVONX Backend Environment Variables
# Simply replace the placeholder values below with your real credentials
# ==============================================================================

# Application Settings
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="AQVONX Hub Backend"

# 1. Neon PostgreSQL Database Connection URL
# Replace with your Neon connection string (ensure postgresql+asyncpg:// format)
DATABASE_URL="postgresql+asyncpg://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?ssl=require"

# 2. Google Gemini API Key (Gemini Flash multimodal inference)
# Get from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="AIzaSy_YOUR_REAL_GEMINI_API_KEY_HERE"

# 3. JWT Signing Secret (Generate using: openssl rand -hex 32)
JWT_SECRET_KEY="replace_with_a_secure_random_64_character_hex_secret_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_EMAILS=["developer@aqvonx.com"]

# 4. Payment Gateway Webhooks & Keys
# Razorpay (India & UPI)
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# LemonSqueezy (Global SaaS & Multi-Currency)
LEMONSQUEEZY_API_KEY="YOUR_LEMONSQUEEZY_API_KEY"
LEMONSQUEEZY_WEBHOOK_SECRET="YOUR_LEMONSQUEEZY_WEBHOOK_SECRET"

# 5. Allowed Origins Whitelist (Explicit web & extension origins)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://aqvonx.com"]
ALLOWED_EXTENSION_IDS=[]

