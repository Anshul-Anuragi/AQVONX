# ==============================================================================
# AQVONX Frontend Environment Variables
# Simply replace the placeholder values below with your real credentials
# ==============================================================================

# 1. Backend API Base URL
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"

# 2. NextAuth / Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="supersecret_nextauth_signing_key_replace_with_openssl_hex"
ADMIN_EMAILS="developer@aqvonx.com"

# 3. Google OAuth for User Sign-In (Optional)
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# 4. Payment Gateway Public Keys (Client-Side Checkouts)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
NEXT_PUBLIC_LEMONSQUEEZY_STORE_ID="your_lemonsqueezy_store_id"

