# ==============================================================================
# AQVONX Monorepo - Git Ignore Rules
# ==============================================================================

# 1. Environment & Secret Credentials (NEVER commit secrets to Git)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Keep example templates committed
!.env.example
!frontend/.env.example
!backend/.env.example

# 2. Python & Virtual Environments (Backend)
backend/venv/
backend/.venv/
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# 3. Node.js & Next.js (Frontend)
frontend/node_modules/
node_modules/
frontend/.next/
.next/
frontend/out/
out/
.turbo/
*.tsbuildinfo

# 4. Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. OS & Editor Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# 6. Extension build packages (Zip bundles)
*.zip
*.crx

